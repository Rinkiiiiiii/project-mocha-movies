# PostgreSQL connection string
# Example for local dev: postgresql://postgres:postgres@localhost:5432/mochamovies
DATABASE_URL="postgresql://user:password@localhost:5432/mochamovies"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-random-32+-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# TMDB (https://www.themoviedb.org/settings/api) - use the "API Read Access Token" (v4 auth)
TMDB_API_KEY="your-tmdb-v3-api-key"
